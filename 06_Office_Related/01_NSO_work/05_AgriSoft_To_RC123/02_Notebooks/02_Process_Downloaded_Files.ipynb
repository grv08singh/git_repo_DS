    "# Check if a file is a ZIP File\n",
    "def is_zip(file_path):\n",
    "    try:\n",
    "        with zipfile.ZipFile(file_path, 'r') as zf:\n",
    "            return True\n",
    "    except zipfile.BadZipFile:\n",
    "        return False"
   ]
