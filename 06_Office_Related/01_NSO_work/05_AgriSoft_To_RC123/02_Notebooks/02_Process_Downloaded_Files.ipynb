    "def dir_content(dir_path):\n",
    "    subdir_list = []\n",
    "    dir_content = os.listdir(dir_path)\n",
    "    for entry in dir_content:\n",
    "        if entry.is_dir():\n",
    "            subdir_list.append(entry.name)\n",
    "    return subdir_list"
   ]
  },
