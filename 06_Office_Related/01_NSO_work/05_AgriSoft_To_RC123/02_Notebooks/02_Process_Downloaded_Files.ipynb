   "source": [
    "# Check if a file is a tar File\n",
    "def is_tar(file_path):\n",
    "    try:\n",
    "        return tarfile.is_tarfile(file_path)\n",
    "    except (FileNotFoundError, OSError):\n",
    "        return False"
   ]
