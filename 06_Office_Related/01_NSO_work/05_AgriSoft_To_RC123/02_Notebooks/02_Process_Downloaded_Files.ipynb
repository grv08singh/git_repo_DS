    "def aggregate_basic_zip(dir_path, basic_zip_dir_path, unnecessary_files_path):\n",
    "    # if subdirectories present at current path, move their content to parent directory recursively\n",
    "    subdirectories = dir_content(dir_path)\n",
    "    if len(subdirectories) > 0:\n",
    "        parent_dir = dir_path\n",
    "        for child_dir in subdirectories:\n",
    "            move_contents(child_dir, parent_dir)\n",
    "        \n",
    "    # now no directories are present at current location\n",
    "    files = os.listdir(dir_path)\n",
    "    for file in files:\n",
    "        if not is_archive(file):\n",
    "            shutil.move(file, unnecessary_files_path)\n",
    "        else:\n",
    "            new_folder = dir_path / \"new_folder\"\n",
    "            os.makedirs(new_folder, exist_ok=True)\n",
    "            \n",
    "            if is_rar(file):\n",
    "                with rarfile.RarFile(file) as rf:\n",
    "                    rf.extractall(new_folder)\n",
    "            if is_tar(file):\n",
    "                with tarfile.open(file, 'r') as tar:\n",
    "                    tar.extractall(new_folder)\n",
    "            if is_zip(file):\n",
    "                if not is_base_zipfile(file):\n",
    "                    with zipfile.ZipFile(file, 'r') as zf:\n",
    "                        zf.extractall(new_folder)\n",
    "                else:\n",
    "                    shutil.move(file, basic_zip_dir_path)\n",
    "    \n",
    "    if is_subdirectory(dir_path, new_folder):\n",
    "        aggregate_basic_zip(new_folder, basic_zip_dir_path, unnecessary_files_path)"
   ]
  },
