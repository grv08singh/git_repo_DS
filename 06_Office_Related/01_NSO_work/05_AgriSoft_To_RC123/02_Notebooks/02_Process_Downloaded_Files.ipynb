    "def aggregate_basic_zip(curr_path, parent_dir, irrelevant_files_dir, basic_zip_dir, processed_archives_dir):\n",
    "    # if subdirectories present at current path, move their content to parent directory recursively\n",
    "    for item in parent_dir.iterdir():\n",
    "        if item.isdir():\n",
    "            move_contents(child_dir, parent_dir)\n",
    "        \n",
    "    subdirectories = dir_content(curr_path)\n",
    "    if len(subdirectories) > 0:\n",
    "        parent_dir = curr_path\n",
    "        for child_dir in subdirectories:\n",
    "            move_contents(child_dir, parent_dir)\n",
    "        \n",
    "    # now no directories are present at current location\n",
    "    for file in curr_path.iterdir():\n",
    "        new_folder = curr_path / \"new_folder\"\n",
    "        os.makedirs(new_folder, exist_ok=True)\n",
    "        \n",
    "        if is_rar(file):\n",
    "            with rarfile.RarFile(file) as rf:\n",
    "                rf.extractall(new_folder)\n",
    "        elif is_tar(file):\n",
    "            with tarfile.open(file, 'r') as tar:\n",
    "                tar.extractall(new_folder)\n",
    "        elif is_zip(file):\n",
    "            if is_base_zipfile(file):\n",
    "                shutil.move(file, basic_zip_dir)\n",
    "            else:\n",
    "                with zipfile.ZipFile(file, 'r') as zf:\n",
    "                    zf.extractall(new_folder)\n",
    "        else:\n",
    "            shutil.move(file, irrelevant_files_dir)\n",
    "    \n",
    "    if is_subdirectory(curr_path, new_folder):\n",
    "        aggregate_basic_zip(new_folder, basic_zip_dir, irrelevant_files_dir)"
