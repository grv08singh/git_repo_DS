   "source": [
    "# is zip, rar or tar\n",
    "def is_archive(file_path):\n",
    "    if is_zip(file_path):\n",
    "        return True\n",
    "    if is_rar(file_path):\n",
    "        return True\n",
    "    if is_tar(file_path):\n",
    "        return True\n",
    "    return False"
   ]
