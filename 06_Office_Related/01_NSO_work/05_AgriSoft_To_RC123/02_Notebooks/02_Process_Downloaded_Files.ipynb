   "source": [
    "# Check if a file is a Rar File\n",
    "def is_rar(file_path):\n",
    "    try:\n",
    "        with rarfile.RarFile(file_path) as rf:\n",
    "            return True\n",
    "    except (rarfile.RarCannotExec, rarfile.BadRarFile):\n",
    "        return False"
   ]
  },
