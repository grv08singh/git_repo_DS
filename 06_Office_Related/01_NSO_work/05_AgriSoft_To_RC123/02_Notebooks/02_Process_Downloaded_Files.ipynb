    "import zipfile\n",
    "def is_base_zipfile(zip_path, filename='BasicFile.csv'):\n",
    "    with zipfile.ZipFile(zip_path, 'r') as zf:\n",
    "        namelist = zf.namelist()\n",
    "        return filename in namelist"
