{
    "editor.fontFamily": "Courier New",
    "editor.fontSize": 15,
    "editor.fontLigatures": true,
    "editor.fontWeight": 600,
    "terminal.integrated.fontSize": 15,
    "terminal.integrated.fontWeight": 600,
    
    "workbench.colorCustomizations": {
        "titleBar.activeBackground":"#004cbf",
        "titleBar.activeForeground":"#FFFFFF",

        "activityBar.background": "#008e8e",
        "activityBar.foreground":"#ffff03",
        "activityBar.inactiveForeground": "#FFFFFF",

        "sideBarTitle.background":"#37b0b0",
        "sideBarTitle.foreground":"#000000",

        "sideBarSectionHeader.background":"#74cccc",
        "sideBarSectionHeader.foreground": "#000000",
        
        "sideBar.background": "#b0e0e0",
        "sideBar.foreground": "#000000",

        //"editorGroupHeader.tabsBackground":"#e4f4f4",
        "tab.border":"#000000",

        "tab.activeBackground": "#e4f4f4",
        "tab.activeForeground": "#000000",
        //"tab.activeBorder":"#007777",

        "tab.inactiveBackground": "#b0e0e0",
        "tab.inactiveForeground": "#007777",

        "breadcrumb.background":"#ffffff",
        "breadcrumb.foreground":"#008e8e",

        "editor.background": "#e4f4f4",
        "editor.foreground":"#000000",
        
        "editor.lineHighlightBackground": "#ceeaea",
        "editor.selectionBackground": "#beeaea",

        "notebook.cellEditorBackground": "#ecf8f8",
        "notebook.editorBackground": "#f9ffff",

        "panel.background":"#b0e0e0",
        "panelTitle.activeForeground":"#007777",
        "panelTitle.activeBorder":"#007777",
        "panelTitle.inactiveForeground":"#000000",

        "terminal.background":"#e4f4f4",
        "terminal.foreground":"#000000",
        "window.inactiveBorder":"#000000"
    },
    "workbench.colorTheme": "Light+",
    "amazonQ.suppressPrompts": {
        "amazonQChatDisclaimer": true,
        "amazonQChatPairProgramming": true
    },

    "editor.semanticTokenColorCustomizations": {
        "rules": {
            "module": {
                "foreground": "#0077ff",
                "fontStyle": "bold"
            },
            "class":{
                "foreground": "#067e00",
                "fontStyle": "bold"
            },
            "method": {
                "foreground": "#ff00ee",
                "fontStyle": "bold"
            },
            "function": {
                "foreground": "#ff00ee",
                "fontStyle": "bold"
            }
        }
    },

    "editor.tokenColorCustomizations": {
        "[Light+]": {
            "textMateRules": [
                {
                    "scope": [
                        "meta.member.access.python",
                        "meta.attribute.python",
                        "keyword.control.import.python"
                    ],
                    "settings": {
                        "fontStyle": "bold"
                    }
                }
            ]
        }
    },
    "explorer.confirmDelete": false,
    "terminal.integrated.enableMultiLinePasteWarning": "never",
    "editor.minimap.enabled": false,
    "claudeCode.preferredLocation": "panel",
    "python.terminal.useEnvFile": true,
    "explorer.confirmDragAndDrop": false

}