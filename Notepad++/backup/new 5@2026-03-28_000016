# ============================================================
# pytorch_gpu Environment Setup Script
# Python 3.11.9 | PyTorch 2.7 cu128 | CUDA Driver 13.2
# ============================================================

Write-Host "========================================" -ForegroundColor Cyan
Write-Host " STEP 1: Removing old env (if exists)" -ForegroundColor Cyan
Write-Host "========================================" -ForegroundColor Cyan
conda deactivate
conda env remove -n pytorch_gpu -y

Write-Host ""
Write-Host "========================================" -ForegroundColor Cyan
Write-Host " STEP 2: Creating new conda environment" -ForegroundColor Cyan
Write-Host "========================================" -ForegroundColor Cyan
conda create -n pytorch_gpu python=3.11.9 -y

Write-Host ""
Write-Host "========================================" -ForegroundColor Cyan
Write-Host " STEP 3: Activating environment" -ForegroundColor Cyan
Write-Host "========================================" -ForegroundColor Cyan
conda activate pytorch_gpu

Write-Host ""
Write-Host "========================================" -ForegroundColor Cyan
Write-Host " STEP 4: Upgrading pip" -ForegroundColor Cyan
Write-Host "========================================" -ForegroundColor Cyan
python -m pip install --upgrade pip setuptools wheel

Write-Host ""
Write-Host "========================================" -ForegroundColor Cyan
Write-Host " STEP 5: Installing PyTorch 2.7 (cu128)" -ForegroundColor Cyan
Write-Host "========================================" -ForegroundColor Cyan
pip install torch==2.7.0 torchvision==0.22.0 torchaudio==2.7.0 --index-url https://download.pytorch.org/whl/cu128

Write-Host ""
Write-Host "========================================" -ForegroundColor Cyan
Write-Host " STEP 6: Installing ML packages" -ForegroundColor Cyan
Write-Host "========================================" -ForegroundColor Cyan
pip install transformers==4.40.2 datasets==2.19.0 evaluate==0.4.2 accelerate==0.30.0 sacrebleu==2.4.3 sentencepiece==0.2.0 protobuf==4.25.3 scikit-learn==1.4.2 pandas==2.2.2 numpy==1.26.4 tqdm==4.66.4

Write-Host ""
Write-Host "========================================" -ForegroundColor Cyan
Write-Host " STEP 7: Installing Jupyter" -ForegroundColor Cyan
Write-Host "========================================" -ForegroundColor Cyan
pip install ipykernel==6.29.4 notebook==7.2.0 jupyterlab==4.2.0

Write-Host ""
Write-Host "========================================" -ForegroundColor Cyan
Write-Host " STEP 8: Registering Jupyter kernel" -ForegroundColor Cyan
Write-Host "========================================" -ForegroundColor Cyan
python -m ipykernel install --user --name pytorch_gpu --display-name "Python 3.11 (pytorch_gpu)"

Write-Host ""
Write-Host "========================================" -ForegroundColor Cyan
Write-Host " STEP 9: Verifying installation" -ForegroundColor Cyan
Write-Host "========================================" -ForegroundColor Cyan
python -c "
import sys, torch, transformers, datasets, evaluate, sentencepiece, sklearn, pandas, numpy

print('')
print('='*50)
print('   ENVIRONMENT VERIFICATION REPORT')
print('='*50)
print(f'  Python       : {sys.version.split()[0]}')
print(f'  PyTorch      : {torch.__version__}')
print(f'  CUDA avail   : {torch.cuda.is_available()}')
if torch.cuda.is_available():
    print(f'  CUDA runtime : {torch.version.cuda}')
    print(f'  GPU          : {torch.cuda.get_device_name(0)}')
    print(f'  VRAM         : {round(torch.cuda.get_device_properties(0).total_memory/1e9,2)} GB')
print(f'  Transformers : {transformers.__version__}')
print(f'  Datasets     : {datasets.__version__}')
print(f'  Evaluate     : {evaluate.__version__}')
print(f'  Sentencepiece: {sentencepiece.__version__}')
print(f'  Scikit-learn : {sklearn.__version__}')
print(f'  Pandas       : {pandas.__version__}')
print(f'  NumPy        : {numpy.__version__}')
print('='*50)
print('')

print('  Testing MarianMT model load...')
from transformers import MarianTokenizer, MarianMTModel
tok = MarianTokenizer.from_pretrained('Helsinki-NLP/opus-mt-en-hi')
mdl = MarianMTModel.from_pretrained('Helsinki-NLP/opus-mt-en-hi')
inp = tok(['Hello, how are you?'], return_tensors='pt', padding=True)
out = mdl.generate(**inp)
result = tok.decode(out[0], skip_special_tokens=True)
print(f'  Test EN->HI  : Hello, how are you?')
print(f'  Translation  : {result}')
print('='*50)
print('  ALL OK — Environment is ready to use!')
print('='*50)
"

Write-Host ""
Write-Host "========================================" -ForegroundColor Green
Write-Host " STEP 10: Launching Jupyter Notebook" -ForegroundColor Green
Write-Host "========================================" -ForegroundColor Green
jupyter notebook --notebook-dir="D:\05 GIT\12_GenAI_projects\01_EngHin_Translator_EncDec"


