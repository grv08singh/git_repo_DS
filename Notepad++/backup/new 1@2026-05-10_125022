-- 9. TRIGGERS
------------------------------------------------------------
CREATE TRIGGER dbo.trg_AfterInsertOrder
ON dbo.Orders
AFTER INSERT
AS
BEGIN
    SET NOCOUNT ON;

    INSERT INTO dbo.OrderAuditLog (OrderID, CustomerID, Action)
    SELECT OrderID, CustomerID, 'INSERT'
    FROM inserted;
END;
GO

CREATE TRIGGER dbo.trg_InsteadOfDeleteOrder
ON dbo.vw_CustomerOrders
INSTEAD OF DELETE
AS
BEGIN
    SET NOCOUNT ON;

    UPDATE dbo.Orders
    SET Status = 'Cancelled'
    WHERE OrderID IN (SELECT OrderID FROM deleted);
END;
GO

